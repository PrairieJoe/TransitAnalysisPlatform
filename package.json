{
  "name": "transit-analysis-platform",
  "version": "0.1.0",
  "description": "교통카드 데이터를 요일별 승차인원 보고서로 변환하는 Windows 분석 앱",
  "author": "Transit Analysis Platform",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -b && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run --pool=threads --maxWorkers=1 --minWorkers=1",
    "test:watch": "vitest --pool=threads --maxWorkers=1 --minWorkers=1",
    "typecheck": "tsc --noEmit",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.5",
    "echarts": "^5.6.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "build": {
    "appId": "com.transitanalysis.platform",
    "productName": "Transit Analysis Platform",
    "directories": {
      "output": "release"
    },
    "files": [
      "out"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "TransitAnalysisPlatform-${version}-setup.${ext}"
    }
  }
}
