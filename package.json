{
  "name": "transit-analysis-platform",
  "version": "0.7.0",
  "description": "교통카드 데이터를 요일별·시간대별·정류장별 수요 보고서로 변환하는 Windows 분석 앱",
  "author": "Transit Analysis Platform",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -b && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run tests --exclude deps/motis-v2.11.3/ui/tests/** --pool=threads --maxWorkers=1 --minWorkers=1",
    "benchmark:analysis": "vite-node --script scripts/benchmark-analysis.mts",
    "benchmark:motis-matrix": "vite-node --script scripts/benchmark-motis-matrix.mts",
    "test:week-ui": "node scripts/validate-week-ui.mjs",
    "test:road-shapes": "vite-node --script scripts/validate-road-shapes.mts",
    "test:watch": "vitest tests --exclude deps/motis-v2.11.3/ui/tests/** --pool=threads --maxWorkers=1 --minWorkers=1",
    "test:motis-scenario": "vite-node --script scripts/run-motis-scenario.mts",
    "typecheck": "tsc --noEmit",
    "motis:verify-builder-lock": "node scripts/motis/builder-lock.mjs",
    "motis:validate-release-candidate": "vite-node --script scripts/motis/validate-release-candidate.mts",
    "motis:prepare": "node scripts/motis/prepare-patched-windows.mjs",
    "package:win": "npm run motis:prepare && npm run build && node scripts/package-win.mjs"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.5",
    "@types/leaflet": "^1.9.22",
    "echarts": "^5.6.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.186.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "build": {
    "appId": "com.transitanalysis.platform",
    "productName": "Transit Analysis Platform",
    "directories": {
      "output": "release"
    },
    "files": [
      "out"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "TransitAnalysisPlatform-${version}-setup.${ext}"
    }
  }
}
